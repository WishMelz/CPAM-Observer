{
  "name": "cpam-observer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cf": "node bin/build-cloudflare.mjs",
    "preview:cf": "opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare deploy",
    "check:cf": "wrangler deploy --dry-run",
    "test:cf": "node bin/test-cloudflare.mjs",
    "lint": "eslint src/app src/server next.config.ts open-next.config.ts bin/build-cloudflare.mjs bin/test-cloudflare.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/security.test.mjs",
    "test:browser": "npm run build && node bin/test-browser.mjs"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.2",
    "@uiw/react-codemirror": "^4.25.12",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "i18next": "^26.4.5",
    "motion": "^12.43.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "sass": "^1.105.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "typescript": "^5",
    "wrangler": "^4.151.0"
  }
}
